# API authentication key used by the /match endpoint.
# REQUIRED — the application will refuse to start if this is not set.
# There is no default. Generate a strong random value for each environment.
API_KEY=dev-secret-key

# Path to the alumni dataset used by the matching engine
DATA_PATH=data/sample_alumni.csv

# Logging level for the API service
LOG_LEVEL=INFO

# Per-API-key rate limiting — sliding window, in-memory per worker process.
# RATE_LIMIT_MAX:    maximum number of requests allowed per key within the window (default: 60)
# RATE_LIMIT_WINDOW: window duration in seconds (default: 60)
# Note: counters are process-local. With --workers 4 the effective limit is
# RATE_LIMIT_MAX * 4 per container. Counters reset on process restart.
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW=60

# Path to the seeded SQLite database (optional).
# If set and the file exists, the DB loader is used instead of the CSV loader.
# If unset or the file does not exist, falls back to DATA_PATH (CSV).
# DB-backed mode additionally enables:
#   - Alumni write operations: POST, PUT, DELETE /v1/alumni
#   - API key management:      POST /v1/users, POST /v1/users/{user_id}/keys,
#                              DELETE /v1/keys/{key_id}, GET /v1/keys
# Generate with: python execution/seed_database.py
# DATABASE_PATH=data/alumni.db

# Version string returned by GET /v1/version (optional, defaults to "0.1.0")
# SERVICE_VERSION=0.1.0

# Deployment environment label returned by GET /v1/version (optional, omitted if unset)
# ENVIRONMENT=production